[Unit]
Description=Palimpsest Novel Engineering Workbench
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/palimpsest
ExecStart=/home/ubuntu/palimpsest/.venv/bin/palimpsest serve --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
